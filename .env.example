# Local development only. Replace the placeholder before starting PostgreSQL.
POSTGRES_DB=travel_agency
POSTGRES_USER=travel_agency
POSTGRES_PASSWORD=replace_with_a_local_random_password
POSTGRES_PORT=5432
ConnectionStrings__TravelAgency="Host=127.0.0.1;Port=5432;Database=travel_agency;Username=travel_agency;Password=replace_with_a_local_random_password;Timeout=3;Command Timeout=5"
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080
Cors__AllowedOrigins__0=http://localhost:5173

# Development-only capture transport; no external emails are sent.
Email__Provider=Capture
Email__BusinessName="Your Travel Planner"
Email__FromAddress=local@travel.invalid
Email__AgentRecipient=agent@travel.invalid
Email__CaptureDirectory=.local-mail
Email__MaxAttempts=8
Email__PollSeconds=5
Email__WorkerEnabled=true
Requests__ReferencePrefix=TRV
Requests__IdempotencyRetentionDays=30
Requests__RequestRetentionDays=365
# Enable only after the owner approves retention/deletion rules.
Requests__PurgeExpiredRequests=false
Requests__PermitLimit=10
Requests__WindowSeconds=60
# For production set Email__Provider=Resend, approved addresses and Email__ApiKey through secret configuration.

# Administrator sessions. Provisioning is explicit; no account is created at startup.
Admin__SessionMinutes=30
# Supply Admin__Email, Admin__DisplayName and Admin__InitialPassword securely only when running --provision-admin.
# Never use VITE_ variables for administrator passwords or session secrets.

# Quotations: drafts work without commercial issuance approval.
Quotations__IssuanceEnabled=false
Quotations__ReferencePrefix=QUO
Quotations__PublicOrigin=http://localhost:5173
Quotations__DefaultValidityDays=14
Quotations__AccessRetentionDays=30
Quotations__PublicPermitLimit=60
# Supply only owner/adviser-approved configuration before enabling issuance:
# Quotations__ApprovedTaxTreatments__0=...
# Quotations__ApprovedTaxRatesBasisPoints__0=...
# Quotations__TermsVersion=...
# Quotations__TermsSv=...
# Quotations__TermsEn=...
# Quotations__AcceptanceTextSv=...
# Quotations__AcceptanceTextEn=...

# Phase 7: commercial invoice issuance and payments stay disabled by default.
Payments__Provider=Disabled
Payments__IssuanceEnabled=false
Payments__AccountingApproved=false
Payments__PublicOrigin=http://localhost:5173
Payments__AccessDays=90
# No live provider is approved or integrated. Sandbox is Development-only and never charges money.
# For isolated test fixtures only: Payments__Provider=Sandbox plus a random Payments__SandboxSigningSecret (>=32 characters).
# Issuance also needs explicit owner/adviser-approved seller and tax/terms configuration:
# Payments__SellerName, Payments__SellerAddress, Payments__RegistrationNumber, Payments__TaxInformation
# Payments__TermsSv, Payments__TermsEn, Payments__TermsVersion
# Reuses Quotations__ApprovedTaxTreatments and Quotations__ApprovedTaxRatesBasisPoints.
# Never place payment secrets in VITE_ variables. Never use test business/legal text commercially.

# Phase 8: real verified research eligibility is required; there is no payment bypass.
Proposals__SendingEnabled=false
Proposals__PublicOrigin=http://localhost:5173
Proposals__DefaultValidityDays=14
Proposals__AccessRetentionDays=30
# Before sending, supply owner-reviewed proposal terms, approval limits and acknowledgement:
# Proposals__TermsVersion, Proposals__TermsSv, Proposals__TermsEn
# Proposals__AcceptanceTextSv, Proposals__AcceptanceTextEn
# Do not invent authority to incur supplier costs. No supplier bookings occur in Phase 8.

# Customer account links: required approved HTTPS origin in production.
# Development defaults to http://localhost:5173. Never put secrets in VITE variables.
CustomerPortal__PublicOrigin=http://localhost:5173
CustomerPortal__SessionMinutes=60
CustomerPortal__ActionMinutes=60

# Phase 11: private document development adapter; never use a public/repository directory.
# LocalEncrypted is the Development default; production remains Disabled until a reviewed adapter exists.
# TravelDocuments__Provider=LocalEncrypted
# TravelDocuments__StorageRoot=/absolute/private/directory/outside/repository
TravelDocuments__MaxBytes=10485760
TravelDocuments__DraftRetentionDays=30
TravelDocuments__ArchivedRetentionDays=90
TravelDocuments__ScannerHost=127.0.0.1
TravelDocuments__ScannerPort=3310
TravelDocuments__ScanTimeoutSeconds=5
# Run an updated ClamAV daemon on a private loopback endpoint. Without a complete clean result,
# uploads remain quarantined and cannot be published, downloaded or previewed.

# Phase 12: asynchronous messaging; no live chat or message attachments.
Messaging__MaxMessageLength=5000
Messaging__NotificationDelaySeconds=30
Messaging__NotificationCooldownSeconds=300
Messaging__CustomerEmailNotifications=true
Messaging__AgentEmailNotifications=true
Messaging__AgentLanguage=sv
Messaging__ClosedRetentionDays=365
# Enable only after the owner approves the closed-conversation retention policy.
Messaging__PurgeClosedConversations=false
