# Local development only. Replace the placeholder before starting PostgreSQL.
POSTGRES_DB=travel_agency
POSTGRES_USER=travel_agency
POSTGRES_PASSWORD=replace_with_a_local_random_password
POSTGRES_PORT=5432
ConnectionStrings__TravelAgency="Host=127.0.0.1;Port=5432;Database=travel_agency;Username=travel_agency;Password=replace_with_a_local_random_password;Timeout=3;Command Timeout=5"
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080
Cors__AllowedOrigins__0=http://localhost:5173

# Development-only capture transport; no external emails are sent.
Email__Provider=Capture
Email__BusinessName="Your Travel Planner"
Email__FromAddress=local@travel.invalid
Email__AgentRecipient=agent@travel.invalid
Email__CaptureDirectory=.local-mail
Email__MaxAttempts=8
Email__PollSeconds=5
Email__WorkerEnabled=true
Requests__ReferencePrefix=TRV
Requests__IdempotencyRetentionDays=30
Requests__RequestRetentionDays=365
# Enable only after the owner approves retention/deletion rules.
Requests__PurgeExpiredRequests=false
Requests__PermitLimit=10
Requests__WindowSeconds=60
# For production set Email__Provider=Resend, approved addresses and Email__ApiKey through secret configuration.

# Administrator sessions. Provisioning is explicit; no account is created at startup.
Admin__SessionMinutes=30
# Supply Admin__Email, Admin__DisplayName and Admin__InitialPassword securely only when running --provision-admin.
# Never use VITE_ variables for administrator passwords or session secrets.
